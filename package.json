{
  "name": "nusantara-express",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@nusantara-express/frontend",
    "dev:backend": "npm run dev --workspace=@nusantara-express/backend",
    "build": "npm run build --workspace=@nusantara-express/frontend && npm run build --workspace=@nusantara-express/backend",
    "build:frontend": "npm run build --workspace=@nusantara-express/frontend",
    "build:backend": "npm run build --workspace=@nusantara-express/backend",
    "start": "npm run start --workspace=@nusantara-express/frontend",
    "lint": "npm run lint --workspace=@nusantara-express/frontend && npm run lint --workspace=@nusantara-express/backend",
    "db:generate": "npm run db:generate --workspace=@nusantara-express/backend",
    "db:push": "npm run db:push --workspace=@nusantara-express/backend",
    "db:seed": "npm run db:seed --workspace=@nusantara-express/backend",
    "db:routes": "npm run db:routes --workspace=@nusantara-express/backend"
  }
}
